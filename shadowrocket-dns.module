#!name=DNS 保护
#!desc=保留 Shadowrocket 的 DNS 设置；不包含分流规则，不随主配置更新被覆盖。

[General]
dns-server = https://1.1.1.1/dns-query#proxy,https://8.8.8.8/dns-query#proxy
fallback-dns-server = https://1.1.1.1/dns-query#proxy,https://8.8.8.8/dns-query#proxy
direct-dns-server = https://223.5.5.5/dns-query,https://1.12.12.12/dns-query
proxy-dns-server = https://223.5.5.5/dns-query,https://1.12.12.12/dns-query
dns-direct-system = false
dns-direct-fallback-proxy = false
always-ip-address = true
hijack-dns = :53
ipv6 = true
prefer-ipv6 = false
